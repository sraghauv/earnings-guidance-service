# Transcript corpus (parquet, from kurry/sp500_earnings_transcripts)
EGS_TRANSCRIPTS_PARQUET=/path/to/sp500_earnings_transcripts/parquet_files/part-0.parquet

EGS_DB_PATH=data/egs.db
EGS_CACHE_DIR=.cache

# Extraction provider: ollama | anthropic | fixture
EGS_LLM_PROVIDER=ollama

# Only read when provider=anthropic
ANTHROPIC_API_KEY=
EGS_ANTHROPIC_MODEL=claude-opus-5

# Only read when provider=ollama
EGS_OLLAMA_HOST=http://localhost:11434
EGS_OLLAMA_MODEL=gemma3:4b

# Free tier key from alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
